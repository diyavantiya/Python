#Write a Python program to print the Fibonacci series up to the nth term using a recursive function.

def fibonacci(n):
    if n==0:
        return 0
    if n==1:
        return 1
    else:
        return fibonacci(n-2)+fibonacci(n-1)
    
n=int(input("Enter no of terms of fibonacci seq:"))
result=fibonacci(n)
print("Fibonacci seq:")
for i in range(n):
    print(f"{fibonacci(i)} ")
