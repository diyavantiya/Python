# Write a Python program to find the factorial of each number in a list using a higher order function.

def fact(n):
    if n==0 or n==1:
        return 1
    fact=1
    for i in range(2, n+1):
        fact=fact*i
    return fact

def list_fact(lst):
    return list(map(fact, lst))

num=list(map(int, input("Enter list of no to find factorial:").split()))
result=list_fact(num)
print("Factorial of numbers is:", result)
