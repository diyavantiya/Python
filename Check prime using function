# Write a Python program to check whether a number is prime using a function.
def is_prime(n):
    if n < 2:
        return False
    
    for i in range(2, n):
        if n % i == 0:
            return False
    
    return True

num = int(input("Enter a number to check prime: "))

result = is_prime(num)
print("Is prime:", result)
