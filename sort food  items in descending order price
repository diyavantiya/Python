food_items=[("Pizza", 950), ("Burger", 195), ("Pasta", 540)]
n=len(food_items)
for i in range(n):
    for j in range(0, n-i-1):
        if food_items[j][1] < food_items[j+1][1]:
            food_items[j], food_items[j+1]=food_items[j+1], food_items[j]
print("Sorted list:")
for item in food_items:
    print(item)
