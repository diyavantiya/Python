# Write a Python program to create a list of 10 random numbers and generate the cube of each number.

import random

def cube(lst):
    cube_list=[]
    for n in lst:
        cube_list.append(n**3)
    return cube_list

og_list=[random.randint(1,10) for n in range(10)]
print("Original list: ", og_list)
result=cube(og_list)
print("Cubed list:", result)
