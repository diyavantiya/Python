# Write a Python program to count even and odd numbers in a list using a function.

def count_even_odd(lst):
    even_count=0
    odd_count=0
    for n in lst:
        if n%2==0:
            even_count+=1
        else:
            odd_count+=1
    return even_count, odd_count

num= list(map(int, input("Enter integers to count even and odd numbers: ").split()))
even, odd = count_even_odd(num)
print("Even numbers count:", even)
print("Odd numbers count:", odd)
