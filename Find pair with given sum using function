# Write a Python program to find all pairs of numbers in a list whose sum equals a given number using a function.

def sum_of_pair(lst, sum):
    result=[]
    for i in range(len(lst)):
        for j in range(i+1, len(lst)):
            if lst[i]+lst[j]==sum:
                result.append((lst[i], lst[j]))
    return result

lst=list(map(int, input("Enter list of numbers to find pair with given sum:").split()))
sum=int(input("Enter the target sum: "))
result=sum_of_pair(lst,sum)
print("Pairs with given sum: ", result)
