def count_lower_upper(s):
    result={"uppercase": 0, "lowercase": 0}
    for char in s:
        if char.isupper():
            result["uppercase"]+=1
        elif char.islower():
            result["lowercase"]+=1

    return result

sample_str="Hello World! Python Programming"
counts=count_lower_upper(sample_str)

print("Input String:", sample_str)
print("Count:", counts)
